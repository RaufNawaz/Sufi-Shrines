{
  "name": "sufi-shrines",
  "version": "2.0.0",
  "description": "Bilingual (English/Urdu) interactive map and scholarly archive of 163 sacred sites across Pakistan — Sufi shrines, Hindu temples, and Sikh gurdwaras — with provenance-tracked sources.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaufNawaz/Sufi-Shrines.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-budget.mjs && node scripts/prerender.mjs && node scripts/check-routes-prerendered.mjs",
    "build:e2e": "VITE_BASE_PATH=/ npm run build",
    "preview": "vite preview",
    "lint": "eslint src e2e --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run data:validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "og:image": "node scripts/make-og-image.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "lhci autorun",
    "data:build": "node scripts/data/build-dataset.mjs",
    "data:index": "node scripts/data/build-shrine-index.mjs",
    "data:build:urdu": "python3 urdu-i18n/build_dictionary.py",
    "data:restore-point": "node scripts/data/snapshot-sheet.mjs",
    "verify:pages": "node scripts/check-production-base.mjs",
    "data:build:provenance": "node scripts/data/build-provenance.mjs",
    "data:build:image-shapes": "node scripts/data/build-image-shapes.mjs",
    "data:build:urdu-index": "node scripts/data/build-urdu-article-index.mjs",
    "data:build:content-provenance": "node scripts/data/build-content-provenance.mjs",
    "data:validate": "node scripts/data/validate.mjs && node scripts/data/validate-tours.mjs && python3 urdu-i18n/build_dictionary.py --check && node scripts/data/validate-urdu-leak.mjs && python3 pipeline/urdu_content_qa.py && node scripts/data/build-order-prose.mjs --check && node scripts/data/build-traditions.mjs --check && node scripts/data/build-shrine-index.mjs --check && node scripts/data/verify-kg-proposals.mjs && node scripts/data/validate-kg-identity.mjs && node scripts/data/validate-publication-safety.mjs && node scripts/data/build-image-shapes.mjs --check && node scripts/data/build-urdu-article-index.mjs --check && npm run data:review:check && npm run data:review:figures:check",
    "data:validate:tours": "node scripts/data/validate-tours.mjs",
    "data:validate:urdu-leak": "node scripts/data/validate-urdu-leak.mjs",
    "data:validate:urdu-content": "python3 pipeline/urdu_content_qa.py --verbose",
    "data:validate:kg-proposals": "node scripts/data/verify-kg-proposals.mjs",
    "data:validate:kg-identity": "node scripts/data/validate-kg-identity.mjs",
    "data:validate:publication": "node scripts/data/validate-publication-safety.mjs",
    "data:validate:images": "node scripts/data/validate-images.mjs",
    "data:check:live": "node scripts/data/check-live-sheet.mjs",
    "urdu:build": "bash urdu-i18n/build-all.sh",
    "data:snapshot": "node scripts/data/build-dataset.mjs",
    "data:kg": "npm run data:validate && node scripts/data/build-kg.mjs",
    "data:review:apply": "node scripts/data/apply-review-verdicts.mjs",
    "data:export": "npm run data:kg && node scripts/data/export-jsonld.mjs && node scripts/data/export-rdf.mjs",
    "data:release": "npm run data:validate && npm run data:validate:images && node scripts/data/release.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "data:review": "node scripts/data/build-review-worksheet.mjs",
    "data:review:check": "node scripts/data/build-review-worksheet.mjs --check",
    "data:review:figures": "node scripts/data/build-figure-identity-worksheet.mjs",
    "data:review:figures:check": "node scripts/data/build-figure-identity-worksheet.mjs --check"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "minisearch": "^7.2.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.22.3",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^10.4.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "sharp": "^0.35.2",
    "storybook": "^10.4.6",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^1.4.0",
    "zod": "^4.4.3"
  }
}
