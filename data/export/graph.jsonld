      "@id": "https://github.com/raufnawaz/sufi-shrines/data/order/chishtiyya",
      "name": "Chishtiyya",
      "alternateName": "چشتیہ",
      "description": "One of the most prominent Sufi orders of South Asia, founded by Khwaja Moinuddin Chishti. Emphasises love, tolerance, and music (sama).",
      "foundingDate": "c. 1000"
    },
    {
      "@type": [
        "Organization",
        "SufiOrder"
      ],
      "@id": "https://github.com/raufnawaz/sufi-shrines/data/order/suhrawardiyya",
      "name": "Suhrawardiyya",
      "alternateName": "سہروردیہ",
      "description": "Order founded by Diya ud-Din Abu'n-Najib al-Suhrawardi; became dominant in Multan and Sindh under Bahauddin Zakariya.",
      "foundingDate": "c. 1100"
    },
    {
      "@type": [
        "Organization",
        "SufiOrder"
      ],
      "@id": "https://github.com/raufnawaz/sufi-shrines/data/order/qadiriyya",
      "name": "Qadiriyya",
      "alternateName": "قادریہ",
      "description": "Order tracing to Abd al-Qadir Gilani of Baghdad; arrived in South Asia via multiple chains; strong presence in Punjab.",
      "foundingDate": "c. 1165"
    },
    {
      "@type": [
        "Organization",
        "SufiOrder"
      ],
      "@id": "https://github.com/raufnawaz/sufi-shrines/data/order/qalandariyya",
      "name": "Qalandariyya",
      "alternateName": "قلندریہ",
      "description": "Antinomian Sufi tradition named after the qalandars; characterised by wandering, intoxication of divine love, and freedom from formal religious observance."
    },
