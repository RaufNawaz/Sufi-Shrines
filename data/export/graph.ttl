@prefix schema:  <https://schema.org/> .
@prefix sufi:    <https://github.com/raufnawaz/sufi-shrines/vocab#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wd:      <https://www.wikidata.org/entity/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix shrine:  <https://github.com/raufnawaz/sufi-shrines/data/shrine/> .
@prefix saint:   <https://github.com/raufnawaz/sufi-shrines/data/saint/> .
@prefix order_:  <https://github.com/raufnawaz/sufi-shrines/data/order/> .
@prefix place:   <https://github.com/raufnawaz/sufi-shrines/data/place/> .
@prefix event_:  <https://github.com/raufnawaz/sufi-shrines/data/event/> .

# ── Vocabulary ────────────────────────────────────────────────────────────
sufi:SufiOrder rdfs:subClassOf schema:Organization .
sufi:UrsEvent  rdfs:subClassOf schema:Event .
sufi:buriedAt      rdfs:subPropertyOf schema:location ;
                   rdfs:label "buried at"@en .
sufi:commemorates  rdfs:subPropertyOf schema:about ;
                   rdfs:label "commemorates"@en .
sufi:silsila       rdfs:label "spiritual lineage (silsila)"@en .

# ── Sufi Orders ───────────────────────────────────────────────────────────
order_:chishtiyya
  a schema:Organization, sufi:SufiOrder ;
  schema:name "Chishtiyya"@en ;
  schema:alternateName "چشتیہ"@ar ;
  schema:description """One of the most prominent Sufi orders of South Asia, founded by Khwaja Moinuddin Chishti. Emphasises love, tolerance, and music (sama)."""@en ;
  schema:foundingDate "c. 1000" ;
  .

order_:suhrawardiyya
  a schema:Organization, sufi:SufiOrder ;
  schema:name "Suhrawardiyya"@en ;
  schema:alternateName "سہروردیہ"@ar ;
  schema:description """Order founded by Diya ud-Din Abu'n-Najib al-Suhrawardi; became dominant in Multan and Sindh under Bahauddin Zakariya."""@en ;
  schema:foundingDate "c. 1100" ;
  .

order_:qadiriyya
  a schema:Organization, sufi:SufiOrder ;
  schema:name "Qadiriyya"@en ;
  schema:alternateName "قادریہ"@ar ;
  schema:description """Order tracing to Abd al-Qadir Gilani of Baghdad; arrived in South Asia via multiple chains; strong presence in Punjab."""@en ;
  schema:foundingDate "c. 1165" ;
  .

order_:qalandariyya
  a schema:Organization, sufi:SufiOrder ;
  schema:name "Qalandariyya"@en ;
  schema:alternateName "قلندریہ"@ar ;
  schema:description """Antinomian Sufi tradition named after the qalandars; characterised by wandering, intoxication of divine love, and freedom from formal religious observance."""@en ;
  .

order_:naqshbandiyya
  a schema:Organization, sufi:SufiOrder ;
  schema:name "Naqshbandiyya"@en ;
  schema:alternateName "نقشبندیہ"@ar ;
  schema:description """Order tracing to Baha ud-Din Naqshband Bukhari; emphasises silent dhikr and close adherence to shari'a."""@en ;
  schema:foundingDate "c. 1389" ;
  .

