+def text_recognizer_batch(img_crops, model, converter, device, batch_size=32):
+    if not img_crops:
+        return []
+
+    texts = []
+    for start in range(0, len(img_crops), batch_size):
+        batch_crops = img_crops[start:start + batch_size]
+        images = torch.stack([prepare_line_image(img) for img in batch_crops], dim=0).to(device)
+
+        with torch.inference_mode():
+            preds = model(images)
+            preds_size = torch.IntTensor([preds.size(1)] * images.size(0))
+            _, preds_index = preds.max(2)
+            texts.extend(converter.decode(preds_index.cpu(), preds_size))
+
+    return texts
+
+
