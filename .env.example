# CSV data source — the Google Sheet published as CSV.
# Replace with your own Sheet's published CSV URL if you fork the project.
VITE_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vSmsEsQclqJuEioIHxQa6ZaTf1SmSuKhM-B3RcfEQyK8Ewqy4-c_xe7DOgBWdhMUyvtrzThIVl9Y9df/pub?gid=0&single=true&output=csv

# Optional: MapTiler API key for premium map styles (Streets, Topo).
# If omitted the site falls back to free CARTO Voyager tiles — no signup needed.
# VITE_MAPTILER_KEY=your_maptiler_key_here

# Optional: a custom MapTiler style ID with Worldview > Language forced to English
# (created in MapTiler Cloud's Map Designer). When both this and VITE_MAPTILER_KEY are
# set, this style becomes the default light-mode basemap instead of CARTO Voyager, to
# avoid OpenStreetMap's inconsistent Urdu/English place-name tagging in Pakistan.
# VITE_MAPTILER_STYLE_ID=your_custom_style_id_here

# Opt in to using the custom Map Designer style (VITE_MAPTILER_STYLE_ID) as the
# default RASTER basemap. Off by default: MapTiler answers 403 for raster tiles of
# a custom style on this account, from every origin including production, while the
# same style's style.json returns 200 (measured 18 Aug 2026 — docs/FRONTEND_NOTES.md).
# English labels come from the built-in style's `language=en` parameter instead.
# Set to 1 only after confirming the plan serves custom-style raster tiles.
# VITE_MAPTILER_CUSTOM_STYLE_RASTER=1
